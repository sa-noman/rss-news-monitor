# =============================================================================
# EXAMPLE ONLY — copy to .env / set as platform secrets. Never commit real keys.
# =============================================================================

# ---------- Cloudflare Worker (server-side, secret) ----------
# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# service_role key — Worker-only secret. NEVER expose to the browser,
# never prefix with NEXT_PUBLIC_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: protects the manual POST /run endpoint of the Worker.
ADMIN_TOKEN=
# Optional feature flags (defaults shown)
# ITEMS_PER_FEED=40
# OG_IMAGE_SCRAPE=false          # off until scraping is explicitly approved

# ---------- Next.js website (Vercel) ----------
# These two are PUBLIC values by design (anon key + project URL); RLS keeps
# them read-only. Still set them as environment variables, not in code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: site title shown in the header
# NEXT_PUBLIC_SITE_NAME=News Monitor
